# Konfigurasi build — dibaca oleh GitHub Actions dan Gradle.
# Format: KEY=VALUE (tanpa spasi di sekitar "=" dan tanpa tanda kutip).

# Identitas aplikasi
# APP_NAME = nama yang tampil di launcher, judul layar, dan widget
APP_NAME=Keuangan
APPLICATION_ID=id.dstech.keuangan
VERSION_NAME=1.0
VERSION_CODE=1

# Logo / ikon aplikasi (ikon adaptif, minimal Android 8)
# LOGO_FOREGROUND : logo PNG transparan 432x432, logo di tengah
# ICON_BACKGROUND : warna latar ikon, format #RRGGBB atau #AARRGGBB
LOGO_FOREGROUND=logo/logo_foreground.png
ICON_BACKGROUND=#000000

# Versi Android yang didukung
MIN_SDK=26
TARGET_SDK=34

# Toolchain
JAVA_VERSION=17
GRADLE_VERSION=8.7
ANDROID_PLATFORM=34
BUILD_TOOLS_VERSION=34.0.0
